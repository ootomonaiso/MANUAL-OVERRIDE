{
  "name": "manual-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preprocess": "node scripts/preprocess.mjs",
    "dev": "node scripts/preprocess.mjs && vite",
    "build": "node scripts/preprocess.mjs && vue-tsc && vite build",
    "preview": "vite preview",
    "sfx-test": "vite --open /tools/sfx-test.html",
    "content-editor": "vite --open /tools/content-editor.html",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src --ext .ts,.vue",
    "lint:fix": "eslint src --ext .ts,.vue --fix",
    "validate": "node scripts/validate-json.mjs",
    "check-doc-links": "node scripts/check-doc-links.mjs",
    "bundle-size": "node scripts/check-bundle-size.mjs",
    "new-genre": "node scripts/new-genre.mjs",
    "reach-sim": "node scripts/genre-reach-sim.mjs .",
    "test": "playwright test",
    "test:unit": "vitest run tests/unit",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "test:features": "node scripts/run-feature-tests.mjs",
    "test:e2e": "node tests/test_game.mjs",
    "test:choices": "node tests/test_choices.mjs",
    "test:infinite": "node tests/test_infinite_choices.mjs",
    "test:massive": "node tests/test_massive_choices.mjs",
    "test:unit:ci": "vitest run tests/unit",
    "ci": "npm run typecheck && npm run lint && npm run validate && npm run check-doc-links && npm run test:features && npm run build && npm run bundle-size && npm run test:unit:ci"
  },
  "dependencies": {
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "ajv": "^8.20.0",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.10"
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "battle-skill.schema.json",
  "title": "RPGジャンル: アクティブ/パッシブスキル定義",
  "description": "src/data/skills/*.json のスキーマ。docs/genre/rpg/07-data-schema.md 準拠。1ファイル1スキル。",
  "type": "object",
  "required": ["id", "label", "flavorText", "kind", "mainCategory", "subCategories", "effect"],
  "additionalProperties": false,
  "allowedOps": ["damage", "heal", "shield", "repeat", "modifier",
                  "statBoost", "elementAffinity", "cutRate", "replaceGuard", "healBetweenBattles",
                    "effectBoost", "healTaken"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^(skill|passive)_[a-z0-9_]+$", "description": "active は skill_ 、passive は passive_ プレフィックス" },
    "label": { "type": "string", "minLength": 1 },
    "flavorText": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["active", "passive"] },
    "mainCategory": {
      "type": "string",
      "enum": ["vitality", "guard", "might", "wisdom", "swift", "fatal", "heal", "aegis", "curse", "pierce", "combo"]
    },
    "subCategories": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "enum": ["vitality", "guard", "might", "wisdom", "swift", "fatal", "heal", "aegis", "curse", "pierce", "combo"]
      }
    },
    "element": { "type": "string", "enum": ["physical", "magical", "special"], "description": "active のみ必須" },
    "cooldown": { "type": "integer", "minimum": 0, "description": "active のみ必須" },
    "defaultFocus": { "type": "string", "enum": ["enemy", "self", "ally"], "description": "active のみ必須" },
    "focusRange": { "type": "string", "enum": ["single", "all", "adjacent3"], "description": "active のみ必須" },
    "effects": { "type": "array", "items": { "type": "string", "pattern": "^fx_[a-z0-9_]+$" } },
    "sfx": {
      "type": "object",
      "additionalProperties": false,
      "description": "このスキル専用の効果音。src/data/sfx/*.json の id を指す（active のみ）",
      "properties": {
        "cast": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 }
      }
    },
    "unlockCondition": {
      "type": "object",
      "required": ["category", "points"],
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": "string",
          "enum": ["vitality", "guard", "might", "wisdom", "swift", "fatal", "heal", "aegis", "curse", "pierce", "combo"]
        },
        "points": { "type": "number", "minimum": 0 }
      }
    },
    "effect": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/effectNode" }
    }
  },
  "definitions": {
    "effectNode": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {
          "type": "string",
          "enum": ["damage", "heal", "shield", "repeat", "modifier",
                    "statBoost", "elementAffinity", "cutRate", "replaceGuard", "healBetweenBattles",
                    "effectBoost", "healTaken"]
        }
      }
    }
  }
}

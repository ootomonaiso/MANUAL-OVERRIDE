{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "battle-enemy-set.schema.json",
  "title": "RPGジャンル: 敵セット定義",
  "description": "src/data/rpg/enemy-sets/*.json のスキーマ。1〜5体の敵の組み合わせをまとめて出現させる単位。CLAUDE_TASKS.md 第6フェーズ参照。1ファイル1セット。",
  "type": "object",
  "required": ["id", "label", "members"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^set_[a-z0-9_]+$" },
    "label": { "type": "string", "minLength": 1 },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["enemyId"],
        "additionalProperties": false,
        "properties": {
          "enemyId": { "type": "string", "pattern": "^enemy_[a-z0-9_]+$" },
          "statsOverride": {
            "type": "object",
            "description": "指定した項目だけ敵定義のデフォルト値を上書きする（省略した項目は敵定義のまま）",
            "additionalProperties": false,
            "properties": {
              "hp": { "type": "number" },
              "str": { "type": "number" },
              "def": { "type": "number" },
              "int": { "type": "number" },
              "ref": { "type": "number" },
              "agi": { "type": "number" },
              "hitRate": { "type": "number" },
              "evadeRate": { "type": "number", "const": 0 },
              "critRate": { "type": "number" },
              "critDamageMultiplier": { "type": "number" }
            }
          }
        }
      }
    }
  }
}

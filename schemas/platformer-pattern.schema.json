{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "platformer-pattern.schema.json",
  "title": "手作り部屋パターン集（platformer）",
  "description": "src/data/patterns/platformer.json のスキーマ。垂直・1画面1部屋のクリア&ループ方式。床（起点）は暗黙に生成され、entries に手作りのギミック配置（一方通行足場・バネ）、exit に部屋の出口を持つ。plan/spec-platformer.md 参照。",
  "type": "object",
  "required": ["section", "patterns"],
  "additionalProperties": false,
  "properties": {
    "$comment": { "type": "string" },
    "section": { "const": "platformer_patterns" },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/room" }
    }
  },
  "definitions": {
    "room": {
      "type": "object",
      "required": ["id", "entries", "exit"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "部屋の一意識別子（英小文字・数字・_のみ）"
        },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/definitions/entry" }
        },
        "exit": { "$ref": "#/definitions/entry" }
      }
    },
    "entry": {
      "type": "object",
      "required": ["kind", "x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["oneWayPlatform", "spring"] },
        "x": { "type": "number", "minimum": 0, "description": "帯の左端からの水平距離px" },
        "y": { "type": "number", "minimum": 0, "description": "部屋の床からの高さpx" },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 },
        "driftEnabled": { "type": "boolean", "description": "左右往復する移動足場にする（oneWayPlatform のみ）" },
        "conveyorVx": { "type": "number", "description": "コンベア速度 px/sec（+右 / -左、oneWayPlatform のみ）" },
        "route": { "type": "string", "description": "複数ルートの識別タグ。同タグのentriesで床→exitへの1本の経路を構成する。タグなしは全ルート共通" }
      }
    }
  }
}

{
  "$schema": "../../../schemas/genre.schema.json",
  "id": "rpg",
  "label": "ロールプレイングゲーム",
  "thresholds": { "growth": 8 },
  "enableFeatures": ["hp"],
  "disableFeatures": ["auto_run", "beat_hazard"],
  "scoreFormula": "battlesWon * 150 + avgStat * 4 + bossDefeated * 500 + maxSkillLevel * 100 + traitsAcquired * 80",
  "manualReveal": "これはRPGになりました。成長することが目的です。",
  "theme": "rpg",
  "bgColor": "#1a1200",
  "environment": "dungeon",
  "controls": {
    "jump": "Space",
    "moveLeft": "ArrowLeft",
    "moveRight": "ArrowRight",
    "moveUp": "ArrowUp",
    "moveDown": "ArrowDown",
    "shoot": "Z"
  },
  "gravity": 1600,
  "endingFlavor": "あなたは強くなった。説明書もいつしか経典になっていた。"
}

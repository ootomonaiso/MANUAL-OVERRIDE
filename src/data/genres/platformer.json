{
  "$schema": "../../../schemas/genre.schema.json",
  "id": "platformer",
  "label": "プラットフォームアクション",
  "thresholds": { "aerial": 5, "combo": 4 },
  "enableFeatures": ["pattern_climb", "double_jump", "long_air"],
  "disableFeatures": ["auto_run", "grid_stop", "beat_hazard", "wall_jump", "near_miss_combo"],
  "scoreFormula": "distance",
  "manualReveal": "これはプラットフォームアクションになりました。上へ上へ登り続けてください。",
  "theme": "platformer",
  "bgColor": "#100a08",
  "environment": "dungeon",
  "scrollDirection": "vertical",
  "controls": {
    "jump": "Space",
    "moveLeft": "ArrowLeft",
    "moveRight": "ArrowRight",
    "moveUp": "ArrowUp",
    "moveDown": "ArrowDown"
  },
  "gravity": 1600,
  "endingFlavor": "あなたは砦の頂へ登り詰めた。説明書は溶岩に呑まれて消えた。"
}

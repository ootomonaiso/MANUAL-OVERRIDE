{
  "$schema": "../../../schemas/genre.schema.json",
  "id": "platformer",
  "label": "プラットフォームアクション",
  "thresholds": { "aerial": 5, "combo": 4 },
  "enableFeatures": ["double_jump", "long_air", "platformer"],
  "disableFeatures": ["auto_run", "grid_stop", "beat_hazard"],
  "scoreFormula": "distance * 0.8 + survivedSec * 5",
  "manualReveal": "これはプラットフォームアクションになりました。飛び跳ねてください。",
  "theme": "platformer",
  "bgColor": "#001f3f",
  "environment": "sky",
  "scrollDirection": "vertical",
  "controls": {
    "jump": "Space",
    "moveLeft": "ArrowLeft",
    "moveRight": "ArrowRight",
    "moveUp": "ArrowUp",
    "moveDown": "ArrowDown"
  },
  "gravity": 1600,
  "spawnDensity": { "baseInterval": 550, "minInterval": 400, "decayRate": 0.0002 },
  "endingFlavor": "あなたは高みへ跳んだ。説明書の紙は踏み台になった。"
}

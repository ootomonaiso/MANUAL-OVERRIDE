{
  "$schema": "../../../schemas/genre.schema.json",
  "id": "stg",
  "label": "シューティングゲーム",
  "thresholds": { "range": 4, "enemy": 4 },
  "enableFeatures": ["shoot", "three_way", "enemy_hp"],
  "disableFeatures": ["grid_stop", "puzzle_solve"],
  "scoreFormula": "kills * 120 + distance * 0.8 + maxCombo * 80",
  "manualReveal": "これはシューティングゲームになりました。敵を倒してください。",
  "theme": "stg",
  "bgColor": "#0d0d1a",
  "environment": "space",
  "controls": {
    "jump": "Space",
    "moveLeft": "ArrowLeft",
    "moveRight": "ArrowRight",
    "moveUp": "ArrowUp",
    "moveDown": "ArrowDown",
    "shoot": "z"
  },
  "gravity": 0,
  "endingFlavor": "あなたはすべてを撃ち抜いた。説明書は弾除けにでも使えばよかった。",
  "spawnDensity": {
    "baseInterval": 1500,
    "minInterval": 500,
    "decayRate": 0.00025
  }
}

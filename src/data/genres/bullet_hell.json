{
  "$schema": "../../../schemas/genre.schema.json",
  "id": "bullet_hell",
  "label": "弾幕回避シューティング",
  "thresholds": { "vertical": 4, "enemy": 8 },
  "enableFeatures": ["shoot", "spread_shot", "hp", "boss_stationary", "vertical_scroll"],
  "disableFeatures": ["grid_stop", "auto_run", "slow_precise"],
  "scoreFormula": "survivedSec * 15 + hitsOnBoss * 25 + maxHitCombo * 40",
  "manualReveal": "これは弾幕回避シューティングになりました。画面上部のボスが放つ弾幕を縫ってください。",
  "theme": "stg",
  "bgColor": "#050510",
  "environment": "space",
  "scrollDirection": "vertical",
  "controls": {
    "jump": "Space",
    "moveLeft": "ArrowLeft",
    "moveRight": "ArrowRight",
    "moveUp": "ArrowUp",
    "moveDown": "ArrowDown",
    "shoot": "z"
  },
  "gravity": 1600,
  "endingFlavor": "あなたは無数の弾を避け続けた。説明書の活字も弾丸に見えた。"
}

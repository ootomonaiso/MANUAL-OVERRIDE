{
  "$schema": "../../../schemas/genre.schema.json",
  "id": "aquatic",
  "label": "水中アドベンチャー",
  "thresholds": { "vertical": 3, "aerial": 3, "survive": 4 },
  "enableFeatures": ["pattern_descend"],
  "disableFeatures": ["auto_run", "shoot", "boss", "beat_hazard", "item_pickup", "slow_precise"],
  "scoreFormula": "distance",
  "manualReveal": "これは水中アドベンチャーになりました。岩を乗り継いで深海へ潜ってください。",
  "theme": "aquatic",
  "bgColor": "#000f2a",
  "environment": "ocean",
  "scrollDirection": "vertical",
  "controls": {
    "jump": "Space",
    "moveLeft": "ArrowLeft",
    "moveRight": "ArrowRight"
  },
  "gravity": 220,
  "endingFlavor": "あなたは深淵へ到達した。説明書のインクは水に滲んで消えた。"
}
